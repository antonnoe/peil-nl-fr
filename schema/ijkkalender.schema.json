{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antonnoe.github.io/peil-nl-fr/schema/ijkkalender.schema.json",
  "title": "Peil, ijkkalender",
  "description": "Per maand welke parameters normaal wijzigen en welke instantie dan publiceert. De twee vaste ijkmomenten zijn half december (NL en CAK) en half april (FR).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "ijkmomenten", "maanden"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["versie", "versiedatum", "licentie"],
      "properties": {
        "versie": { "type": "string" },
        "versiedatum": { "$ref": "gemeen.schema.json#/$defs/datum" },
        "licentie": { "type": "string" }
      }
    },
    "ijkmomenten": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sleutel", "naam", "maand", "dag", "domein", "omschrijving"],
        "properties": {
          "sleutel": { "type": "string", "minLength": 1 },
          "naam": { "type": "string", "minLength": 1 },
          "maand": { "type": "integer", "minimum": 1, "maximum": 12 },
          "dag": { "type": "integer", "minimum": 1, "maximum": 31 },
          "domein": { "type": "array", "items": { "type": "string" } },
          "omschrijving": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maanden": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["maand", "naam", "ijkmoment", "verwachte_wijzigingen"],
        "properties": {
          "maand": { "type": "integer", "minimum": 1, "maximum": 12 },
          "naam": { "type": "string", "minLength": 1 },
          "ijkmoment": { "type": ["string", "null"] },
          "verwachte_wijzigingen": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["omschrijving", "instantie", "parameters"],
              "properties": {
                "omschrijving": { "type": "string", "minLength": 1 },
                "instantie": { "type": "string", "minLength": 1 },
                "parameters": { "type": "array", "items": { "type": "string", "pattern": "^p\\.(nl|fr|xb)\\.[a-z0-9_]+\\.[a-z0-9_]+$" } }
              }
            }
          }
        }
      }
    }
  }
}
